{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Trek Documentation",
  "description": "Step-by-step guides for everything you want to do in Trek",
  "colors": {
    "primary": "#246BD4",
    "light": "#6BA8EB",
    "dark": "#1A5099"
  },
  "favicon": "/favicon.ico",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "section"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
