{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Trek Documentation",
  "description": "Step-by-step guides for everything you want to do in Trek",
  "colors": {
    "primary": "#246BD4",
    "light": "#6BA8EB",
    "dark": "#1A5099"
  },
  "favicon": "/favicon.png",
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "section"
  },
  "contextual": {
    "options": ["copy", "view", "assistant", "mcp", "add-mcp"]
  },
  "navigation": {
    "directory": "card",
    "groups": [
      {
        "group": "Orientation",
        "pages": [
          "technical-requirements",
          "rollout-resources"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/yourcompany",
      "linkedin": "https://linkedin.com/company/yourcompany"
    }
  },
  "appearance": {
    "default": "system"
  }
}
